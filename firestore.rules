rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function ehAdmin() {
      return logado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == "admin";
    }

    // qualquer usuário logado da equipe pode ler/lançar leituras
    match /leituras/{id} {
      allow read: if logado();
      allow create: if logado();
      allow update, delete: if ehAdmin();
    }

    // linhas: todos leem, só admin cadastra/edita/exclui
    match /linhas/{id} {
      allow read: if logado();
      allow write: if ehAdmin();
    }

    // usuarios: cada um lê o próprio papel; só admin gerencia
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow write: if ehAdmin();
    }
  }
}
